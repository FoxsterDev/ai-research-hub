{
  "base_url": null,
  "base_url_env": "OPENSEARCH_PULSE_URL",
  "api_key_env": null,
  "api_key_header": "x-api-key",
  "window_days": 3,
  "max_workers": 8,
  "max_aggs_per_search": 2,
  "min_dau": 100,
  "server_type": { "field": "ServerType.keyword", "value": "Prod" },
  "levels": { "error": "Error", "warn": "Warn" },
  "fields": {
    "level": "LogLevel.keyword",
    "message_keyword": "Message.keyword",
    "message_text": "Message",
    "category": "Category.keyword",
    "user": "UUID.keyword",
    "app_id": "AppId.keyword",
    "version": "GameVersion.keyword",
    "platform": "Platform.keyword"
  },
  "sources": [
    {
      "index_prefix": "shared-core-logs-",
      "split_by_app_id": true,
      "app_names": { "APP1": "First App", "APP2": "Second App" }
    },
    {
      "index_prefix": "standalone-core-logs-",
      "split_by_app_id": false,
      "key": "STANDALONE",
      "name": "Standalone App"
    }
  ],
  "signals": {
    "http_429": { "phrase": "429 Too Many Requests", "label": "HTTP 429 rate-limit" },
    "timeout": { "phrase": "Request timed out", "label": "Request timeout" }
  },
  "overview": {
    "source_labels": {
      "loading": "configured login-ready signal",
      "home_ready": "configured home-ready signal",
      "popups_settled": "configured popup-settled signal"
    }
  },
  "funnels": [
    {
      "key": "signup",
      "label": "Signup",
      "apps": ["APP1"],
      "note": "optional note shown under the funnel",
      "stages": [
        { "key": "start", "label": "Started",   "phrase": "signup started",   "category": "Auth" },
        { "key": "done",  "label": "Completed",  "phrase": "signup completed", "category": "Auth" },
        { "key": "failed","label": "Failed",     "phrase": "signup failed",    "category": "Auth" }
      ],
      "rates": [
        { "label": "completion",   "num": "done",   "den": "start",           "good": "high", "good_at": 95, "bad_at": 85, "business": "share of entrants who finish" },
        { "label": "success rate", "num": "done",   "den": ["done", "failed"], "good": "high", "good_at": 98, "bad_at": 95, "business": "of terminal outcomes, share that succeeded" },
        { "label": "reach",        "num": "start",  "den": "dau",             "good": "high", "business": "share of DAU entering signup (volume — left uncoloured)" }
      ]
    }
  ],
  "hygiene": {
    "default": { "verdict": "review" },
    "rules": [
      { "match": { "empty_message": true }, "verdict": "fix",
        "ux": "unhandled exception with no message", "business": "instability / retention risk",
        "owner": "Client Runtime", "action": "enrich the log + fix the root exception" },
      { "match": { "category": "Ads", "phrase": ["no fill", "timeout"] }, "verdict": "ux-assess",
        "ux": "an ad failed to load/show", "business": "lost ad impressions / rewards",
        "owner": "Monetization", "action": "investigate no-fill/timeouts per network" },
      { "match": { "regex": "missing script|referenced script" }, "verdict": "mute",
        "ux": "none (build hygiene chatter)", "business": "no user impact",
        "owner": "Client/Content", "action": "fix in-editor; suppress in prod" }
    ]
  },
  "thresholds": {
    "degraded_pct": 40,
    "watch_pct": 15,
    "new_release_min_share": 0.02
  },
  "brand": { "org": "Your Org", "product": "Production Pulse" },
  "durations": [
    {
      "key": "time_to_ready", "label": "Time to ready", "short_label": "Load time",
      "phrase": "StartupSummary", "category": "Loading", "attribute": "durationMs",
      "divisor": 1000, "unit": "s", "percentiles": [50, 90], "min_samples": 30,
      "cohorts": [
        { "key": "new",       "label": "new install", "attributes_phrase": "sessionNumber 1 durationMs" },
        { "key": "returning", "label": "existing",    "exclude_attributes_phrase": "sessionNumber 1 durationMs" }
      ],
      "thresholds": { "returning": { "p50": { "watch": 3, "alert": 6 }, "p90": { "watch": 6, "alert": 10 } } },
      "note": "shown under the per-project table"
    }
  ],
  "incidents": [
    { "key": "backend_5xx", "label": "Backend HTTP 5xx",
      "phrases": ["HTTP/1.1 500", "HTTP/1.1 502", "HTTP/1.1 503", "HTTP/1.1 504"], "require_phrases": ["ServerError"],
      "category": "Network", "interval_minutes": 5, "min_users": 40, "spike_factor": 5, "endpoint_regex": "'([^']+)'" }
  ]
}
