# Decision the gate returns for tool calls it has no opinion about. This MUST be a real
# decision: a bare {} makes the platform reject the tool call and nothing runs at all.
# "allow" matches the no-hook baseline. Use "ask" when auto-execution is disabled and you
# want the permission prompt back.
PASSTHROUGH_DECISION=allow

# Per-workspace configuration for the shared hook scripts.
# Copy next to hooks.json (i.e. into the customization root) and edit.
# Sourced by ./hooks/*.sh — every value must be a single-quoted ERE string.

# How often the PreInvocation heartbeat re-asserts the discipline (every Nth model call).
HEARTBEAT_EVERY=4

# How many times the Stop hook may block termination in one conversation before
# giving up. Keeps a failing gate from looping forever.
MAX_STOP_CONTINUES=2

# Tool calls to hard-deny, matched against the scrubbed payload.
# Use this for operations that must go through a project's own tooling.
DENY_PATTERNS=''
DENY_REASON='Blocked by the workspace tool gate.'

# Paths where a recursive delete is allowed without confirmation. Anything else
# recursive gets force_ask; a delete targeting the filesystem root is always denied.
SCRATCH_PATTERNS='/private/tmp/|/tmp/|/Library/Caches/'

# Tool names that open an edit batch, and those that close it.
# NOTE: PreToolUse is NOT dispatched for file-edit steps on the builds measured so far
# (docs/PLATFORM_CONTRACT.md 4.1), so this is a best-effort secondary signal. The
# authoritative check is the Stop hook reading the transcript for a CODE_ACTION step
# with no validation step after it — which is driven by VALIDATION_PATTERNS below.
EDIT_TOOLS='code_action|propose_code|write_blob|file_change|edit_notebook|move|delete_directory'
VALIDATION_TOOLS='compile'

# What counts as a validation lane in this workspace. This is the pattern the Stop
# hook looks for after an edit, so it must match how validation actually appears in
# the transcript (command lines, MCP tool names, test runners).
VALIDATION_PATTERNS=''

# Shown to the model when an edit batch has no validation after it. Make it name the
# concrete lane for this workspace, not a generic "run tests".
VALIDATION_REMINDER='A file was edited and no compile, test, or validation lane has run since. Run it, read the real result, and report it before concluding.'

# Optional self-test vectors for tools/test_hooks.sh. TEST_DENY_CMD must be denied;
# TEST_VALIDATION_CMD must close an open edit batch.
TEST_DENY_CMD=''
TEST_VALIDATION_CMD=''

# Set to 1 to log every tool the gate sees, with a payload excerpt. Use when a tool
# name is not matching; leave off otherwise (it is noisy).
GATE_DEBUG=0
