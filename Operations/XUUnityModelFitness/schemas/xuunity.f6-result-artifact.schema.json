{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuunity.local/schemas/xuunity.f6-result-artifact.schema.json",
  "title": "XUUnity F6 Result Artifact",
  "description": "Parent-owned MAC-authenticated evidence binding the blinded F6 holdout to an exact suite, fixture, strict profile, and preregistered attempt roster.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_ref",
    "issuer_key_id",
    "holdout_ref",
    "suite_id",
    "suite_sha256",
    "fixture_id",
    "fixture_sha256",
    "strict_profile_key",
    "attempts",
    "artifact_hash",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "xuunity.f6-result-artifact.v1" },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "issuer_key_id": { "type": "string", "minLength": 1 },
    "holdout_ref": { "type": "string", "minLength": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "suite_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_id": { "type": "string", "minLength": 1 },
    "fixture_sha256": { "$ref": "#/$defs/sha256" },
    "strict_profile_key": { "$ref": "#/$defs/sha256" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attempt_id", "attempt_sha256"],
        "properties": {
          "attempt_id": { "type": "string", "minLength": 1 },
          "attempt_sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "artifact_hash": { "$ref": "#/$defs/sha256" },
    "signature": { "$ref": "#/$defs/sha256" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
