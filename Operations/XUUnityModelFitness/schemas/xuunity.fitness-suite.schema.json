{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuunity.local/schemas/xuunity.fitness-suite.schema.json",
  "title": "XUUnity Fitness Suite",
  "description": "Preregistered suite contract: exact fixture set, sampling unit, statistical decision rule, and adoption thresholds are frozen before any run. Strata and thresholds cannot change after seeing results.",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "revision",
    "fixtures",
    "f6_policy",
    "dimension_aggregation",
    "adoption_thresholds",
    "sampling",
    "dependence_policy",
    "decision_rule",
    "attempt_plan"
  ],
  "properties": {
    "schema_version": { "const": "xuunity.fitness-suite.v2" },
    "suite_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "fixture_sha256",
          "required",
          "stratum",
          "safety_critical"
        ],
        "properties": {
          "fixture_id": { "type": "string", "minLength": 1 },
          "fixture_sha256": { "$ref": "#/$defs/sha256" },
          "required": { "type": "boolean" },
          "stratum": { "type": "string", "minLength": 1 },
          "safety_critical": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "f6_policy": {
      "type": "object",
      "required": [
        "required_for_fit",
        "holdout_ref",
        "fixture_id",
        "issuer_key_id"
      ],
      "properties": {
        "required_for_fit": { "type": "boolean" },
        "holdout_ref": { "type": ["string", "null"] },
        "fixture_id": { "type": ["string", "null"] },
        "issuer_key_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "dimension_aggregation": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["fixture_balanced_median"]
        }
      },
      "additionalProperties": false
    },
    "adoption_thresholds": {
      "type": "object",
      "required": ["fit", "fit_with_supervision"],
      "properties": {
        "fit": { "$ref": "#/$defs/thresholds" },
        "fit_with_supervision": { "$ref": "#/$defs/thresholds" }
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": [
        "replicate_unit",
        "attempts_per_fixture",
        "smoke_attempts",
        "seed_policy_id",
        "randomization_policy_id"
      ],
      "properties": {
        "replicate_unit": { "const": "suite_replicate" },
        "attempts_per_fixture": { "type": "integer", "minimum": 1 },
        "smoke_attempts": { "type": "integer", "minimum": 3 },
        "seed_policy_id": { "type": "string", "minLength": 1 },
        "randomization_policy_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dependence_policy": {
      "type": "object",
      "required": ["cluster_aware", "method_id"],
      "properties": {
        "cluster_aware": { "type": "boolean" },
        "method_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "decision_rule": {
      "type": "object",
      "required": [
        "method_id",
        "implementation_sha256",
        "confidence",
        "power_target",
        "alternative_margin",
        "multiplicity_method"
      ],
      "properties": {
        "method_id": { "type": "string", "minLength": 1 },
        "implementation_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "confidence": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "power_target": { "type": "number", "minimum": 0, "maximum": 1 },
        "alternative_margin": { "type": "number", "minimum": 0 },
        "multiplicity_method": {
          "type": "string",
          "enum": ["holm_bonferroni", "predeclared_stricter"]
        }
      },
      "additionalProperties": false
    },
    "attempt_plan": {
      "type": "object",
      "required": ["scheduled_attempts", "stop_rule", "attempts"],
      "properties": {
        "scheduled_attempts": { "type": "integer", "minimum": 1 },
        "stop_rule": { "const": "fixed" },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["attempt_id", "fixture_id", "replicate_id", "order"],
            "properties": {
              "attempt_id": { "type": "string", "minLength": 1 },
              "fixture_id": { "type": "string", "minLength": 1 },
              "replicate_id": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "suite_hash": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "thresholds": {
      "type": "object",
      "required": [
        "completion_lower_bound_min",
        "median_lower_bound_min",
        "worst_valid_min",
        "invalid_rate_upper_bound_max"
      ],
      "properties": {
        "completion_lower_bound_min": {
          "type": "number", "minimum": 0, "maximum": 1
        },
        "median_lower_bound_min": {
          "type": "number", "minimum": 0, "maximum": 100
        },
        "worst_valid_min": {
          "type": "number", "minimum": 0, "maximum": 100
        },
        "invalid_rate_upper_bound_max": {
          "type": "number", "minimum": 0, "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
