{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuunity.local/schemas/xuunity.resolved-modules.schema.json",
  "title": "XUUnity Resolved Module Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "resolvedAtUtc",
    "projectRoot",
    "writeScope",
    "outputBoundary",
    "entitlements",
    "loadedModules",
    "loadedPacks",
    "lockedPacks",
    "invalidPacks",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xuunity.resolved-modules.v1"
    },
    "resolvedAtUtc": {
      "type": "string"
    },
    "projectRoot": {
      "type": "string"
    },
    "writeScope": {
      "type": "string"
    },
    "outputBoundary": {
      "type": "string",
      "enum": [
        "private_runtime"
      ]
    },
    "entitlements": {
      "type": "object",
      "required": [
        "mode",
        "feature_count",
        "trustLevel",
        "verified",
        "provider"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "feature_count": {
          "type": "integer"
        },
        "trustLevel": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "provider": {
          "type": "object"
        }
      }
    },
    "discoveryRoots": {
      "type": "array"
    },
    "scannedModules": {
      "type": "array"
    },
    "loadedModules": {
      "type": "array"
    },
    "loadedPacks": {
      "type": "array"
    },
    "lockedPacks": {
      "type": "array"
    },
    "invalidPacks": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    }
  }
}
