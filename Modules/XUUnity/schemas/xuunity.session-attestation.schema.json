{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuunity.local/schemas/xuunity.session-attestation.schema.json",
  "title": "XUUnity Session Attestation",
  "description": "Created by the parent runner before exposing the model-writable environment. The model cannot author or replace it. The capability and verification key stay outside the model process; sanitized projections keep only opaque ids and public-safe profile facts.",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_id",
    "session_id",
    "task_identity",
    "repository_content_hash",
    "protocol_content_hash",
    "ruleset_hash",
    "adapter_profile_hash",
    "requested_profile",
    "allowed_roots",
    "policy_ids",
    "collector_identity",
    "broker_identity",
    "capability_id",
    "created",
    "expires",
    "attestation_hash",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "xuunity.session-attestation.v1"
    },
    "attestation_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "task_identity": {
      "type": "string",
      "minLength": 1,
      "description": "Private task hash or host-keyed HMAC; never a raw task text."
    },
    "repository_content_hash": { "$ref": "#/$defs/sha256" },
    "protocol_content_hash": { "$ref": "#/$defs/sha256" },
    "ruleset_hash": { "$ref": "#/$defs/sha256" },
    "adapter_profile_hash": { "$ref": "#/$defs/sha256" },
    "requested_profile": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": ["string", "null"] },
        "effort": { "type": ["string", "null"] },
        "surface": { "type": ["string", "null"] },
        "adapter_cli_version": { "type": ["string", "null"] },
        "permission_mode": { "type": ["string", "null"] },
        "sandbox": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "allowed_roots": {
      "type": "object",
      "required": ["repository", "guidance", "evidence", "mutation"],
      "properties": {
        "repository": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "guidance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mutation": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "policy_ids": {
      "type": "object",
      "required": ["data_classification", "outbound_delivery"],
      "properties": {
        "data_classification": { "type": "string", "minLength": 1 },
        "outbound_delivery": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "collector_identity": { "$ref": "#/$defs/component_identity" },
    "broker_identity": { "$ref": "#/$defs/component_identity" },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque id; the capability value itself never appears in any model-readable artifact."
    },
    "created": { "type": "string", "minLength": 1 },
    "expires": { "type": "string", "minLength": 1 },
    "attestation_hash": { "$ref": "#/$defs/sha256" },
    "signature": {
      "type": ["string", "null"],
      "description": "Parent MAC or signature over attestation_hash; null in sanitized projections."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "component_identity": {
      "type": "object",
      "required": ["id", "version", "implementation_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "implementation_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
