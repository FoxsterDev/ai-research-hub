{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuunity.local/schemas/xuunity.entitlements.schema.json",
  "title": "XUUnity Entitlements",
  "type": "object",
  "required": [
    "schemaVersion",
    "subject",
    "mode",
    "features",
    "source",
    "provider"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xuunity.entitlements.v1"
    },
    "subject": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "personal_dev",
        "signed_offline",
        "online_sync"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expiresAtUtc": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "required": [
        "type",
        "mode",
        "trustLevel",
        "verified",
        "checkedAtUtc"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "personal_dev",
            "signed_offline",
            "online_sync"
          ]
        },
        "trustLevel": {
          "type": "string",
          "enum": [
            "local_flag",
            "signed_offline",
            "server_verified",
            "unknown"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "checkedAtUtc": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "license": {
      "type": "object",
      "properties": {
        "licenseId": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "issuedAtUtc": {
          "type": "string"
        },
        "expiresAtUtc": {
          "type": "string"
        },
        "signatureAlgorithm": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "payloadHash": {
          "type": "string"
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "lastSyncAtUtc": {
          "type": "string"
        },
        "nextSyncAfterUtc": {
          "type": "string"
        }
      }
    }
  }
}
