{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuunity.local/schemas/xuunity.reduced-stack-rules.schema.json",
  "title": "XUUnity Reduced-Stack Ruleset",
  "description": "Machine routing rules that derive the minimum required stack for one task. Owns enforcement mapping only; human explanation stays in the referenced human_owner documents. Paths may use {module} (module root) and {project} (resolved project root) placeholders.",
  "type": "object",
  "required": [
    "schema_version",
    "ruleset_id",
    "ruleset_version",
    "rules",
    "ruleset_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "xuunity.reduced-stack-rules.v1"
    },
    "ruleset_id": { "type": "string", "minLength": 1 },
    "ruleset_version": { "type": "string", "minLength": 1 },
    "override_path_templates": {
      "type": "array",
      "description": "Templates checked for an existing project override of a matched family; {project} and {family} are expanded.",
      "items": { "type": "string", "minLength": 1 }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "ruleset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "description",
        "priority",
        "selectors",
        "requirements",
        "risk",
        "human_owner"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": 0 },
        "selectors": { "$ref": "#/$defs/selectors" },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "override_family": { "type": ["string", "null"] },
        "risk": {
          "type": "string",
          "enum": ["baseline", "normal", "high", "critical"]
        },
        "extension_policy": {
          "type": "object",
          "properties": {
            "allow_add": { "type": "boolean" },
            "allow_replace": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "human_owner": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path (placeholders allowed) of the human document that explains this rule."
        },
        "extends": { "type": ["string", "null"] },
        "replaces_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parent_rule_hash": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "selectors": {
      "type": "object",
      "description": "Every populated family must match (AND across families, OR inside one family).",
      "properties": {
        "always": { "type": "boolean" },
        "protocol_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "task_kinds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "referenced_path_globs_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "planned_path_globs_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "extensions_any": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\." }
        },
        "content_regex_any": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "execution_contract_equals": {
          "type": "object",
          "additionalProperties": { "type": ["string", "integer", "boolean", "null"] }
        },
        "risk_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["baseline", "normal", "high", "critical"]
          }
        },
        "resolved_project_present": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" },
        "mode": {
          "type": "string",
          "enum": ["all_of", "any_of", "at_least", "semantic_checker"]
        },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "from_glob": { "type": ["string", "null"] },
        "min_count": { "type": ["integer", "null"], "minimum": 1 },
        "weight": { "type": "integer", "minimum": 0 },
        "phase": {
          "type": "string",
          "enum": ["before_first_mutation", "before_closeout", "on_reconcile"]
        },
        "optional": { "type": "boolean" },
        "checker_id": { "type": ["string", "null"] },
        "input_schema": { "type": ["string", "null"] },
        "required_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "empty_input_policy": {
          "type": "string",
          "enum": ["fail", "skip"]
        },
        "severity": {
          "type": "string",
          "enum": ["blocking", "advisory"]
        }
      },
      "additionalProperties": false
    }
  }
}
