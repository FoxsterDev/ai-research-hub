{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuunity.local/schemas/xuunity.installer.schema.json",
  "title": "XUUnity Installer Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "moduleId",
    "recommendedMount",
    "requiredFeatures",
    "postInstallChecks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "xuunity.installer.v1"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "displayName": {
      "type": "string"
    },
    "recommendedMount": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "requiredFeatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]*$"
      }
    },
    "postInstallChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "xuunity_module_status",
          "xuunity_module_rollsync"
        ]
      }
    }
  }
}
