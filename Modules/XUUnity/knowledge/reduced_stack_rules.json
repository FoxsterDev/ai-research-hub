{
  "schema_version": "xuunity.reduced-stack-rules.v1",
  "ruleset_id": "xuunity.public.reduced-stack",
  "ruleset_version": "1.0.0",
  "override_path_templates": [
    "{project}/Assets/AIOutput/ProjectMemory/SkillOverrides/{family}.md"
  ],
  "rules": [
    {
      "id": "entrypoint_kernel",
      "description": "Protocol entrypoint is always required.",
      "priority": 10,
      "selectors": {
        "always": true
      },
      "requirements": [
        {
          "id": "entrypoint",
          "mode": "all_of",
          "paths": [
            "{module}/tasks/start_session.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "baseline",
      "human_owner": "{module}/tasks/start_session.md"
    },
    {
      "id": "repo_router",
      "description": "Repository root router is always required.",
      "priority": 11,
      "selectors": {
        "always": true
      },
      "requirements": [
        {
          "id": "repo_router",
          "mode": "any_of",
          "paths": [
            "Agents.md",
            "AGENTS.md",
            "CLAUDE.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "baseline",
      "human_owner": "{module}/utilities/module_session_routing.md"
    },
    {
      "id": "base_role",
      "description": "Base role discipline is always required.",
      "priority": 12,
      "selectors": {
        "always": true
      },
      "requirements": [
        {
          "id": "base_role",
          "mode": "all_of",
          "paths": [
            "{module}/role/base_role.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "baseline",
      "human_owner": "{module}/role/base_role.md"
    },
    {
      "id": "project_router",
      "description": "Resolved project's own router, when the project declares one.",
      "priority": 13,
      "selectors": {
        "resolved_project_present": true
      },
      "requirements": [
        {
          "id": "project_router",
          "mode": "any_of",
          "paths": [
            "{project}/Agents.md",
            "{project}/AGENTS.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation",
          "optional": true
        }
      ],
      "risk": "baseline",
      "human_owner": "{module}/utilities/module_session_routing.md"
    },
    {
      "id": "project_memory",
      "description": "Project memory documents of the resolved project.",
      "priority": 14,
      "selectors": {
        "resolved_project_present": true
      },
      "requirements": [
        {
          "id": "project_memory",
          "mode": "at_least",
          "from_glob": "{project}/Assets/AIOutput/ProjectMemory/*.md",
          "min_count": 1,
          "weight": 2,
          "phase": "before_first_mutation",
          "optional": true
        }
      ],
      "risk": "normal",
      "human_owner": "{module}/knowledge/agent_source_of_truth.md"
    },
    {
      "id": "csharp_code_change",
      "description": "C#/Unity code change loads codestyle and core runtime-safety skills.",
      "priority": 20,
      "selectors": {
        "extensions_any": [
          ".cs"
        ]
      },
      "requirements": [
        {
          "id": "codestyle",
          "mode": "all_of",
          "paths": [
            "{module}/codestyle/csharp.md",
            "{module}/codestyle/unity.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        },
        {
          "id": "skills_core",
          "mode": "at_least",
          "from_glob": "{module}/skills/core/*.md",
          "min_count": 6,
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "override_family": "codestyle",
      "risk": "normal",
      "human_owner": "{module}/codestyle/csharp.md"
    },
    {
      "id": "async_threading",
      "description": "Async, callback, or threading signals load the base async contract and concurrency classification; the signal is not itself proof of cross-thread access.",
      "priority": 21,
      "selectors": {
        "keywords_any": [
          "async",
          "await",
          "unitask",
          "coroutine",
          "callback",
          "callbacks",
          "event handler",
          "thread",
          "threading",
          "synchronization",
          "race condition"
        ]
      },
      "requirements": [
        {
          "id": "skills_async_base",
          "mode": "all_of",
          "paths": [
            "{module}/skills/async/base_async_rules.md",
            "{module}/skills/async/concurrency_classification.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "override_family": "async",
      "risk": "normal",
      "human_owner": "{module}/skills/async/routing.md"
    },
    {
      "id": "async_main_thread_context",
      "description": "Explicit Unity/main-thread boundary signals load the main-thread owner in addition to the async base contract.",
      "priority": 22,
      "selectors": {
        "keywords_any": [
          "main thread",
          "unity thread",
          "switchtomainthread",
          "unitysendmessage",
          "player loop thread",
          "player-loop thread",
          "unity api thread"
        ]
      },
      "requirements": [
        {
          "id": "skills_async_main_thread",
          "mode": "all_of",
          "paths": [
            "{module}/skills/async/main_thread.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "dependencies": [
        "async_threading"
      ],
      "risk": "high",
      "human_owner": "{module}/skills/async/main_thread.md"
    },
    {
      "id": "async_dotnet_task",
      "description": "Explicit .NET task or thread-pool signals load the .NET Task interop owner in addition to the async base contract.",
      "priority": 22,
      "selectors": {
        "keywords_any": [
          "configureawait",
          "task.run",
          ".net task",
          "system.threading.tasks",
          "switchtothreadpool",
          "threadpool",
          "pool thread",
          "thread-pool",
          "thread pool"
        ]
      },
      "requirements": [
        {
          "id": "skills_async_dotnet_task",
          "mode": "all_of",
          "paths": [
            "{module}/skills/async/dotnet_task.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "dependencies": [
        "async_threading"
      ],
      "risk": "high",
      "human_owner": "{module}/skills/async/dotnet_task.md"
    },
    {
      "id": "async_sync_primitives",
      "description": "Synchronization vocabulary loads the concurrency evidence gate before a primitive is accepted.",
      "priority": 22,
      "selectors": {
        "keywords_any": [
          "lock",
          "monitor",
          "interlocked",
          "volatile",
          "semaphoreslim",
          "semaphore",
          "concurrent collection",
          "thread-safe",
          "threadsafe",
          "atomic"
        ]
      },
      "requirements": [
        {
          "id": "concurrency_classification_for_primitive",
          "mode": "all_of",
          "paths": [
            "{module}/skills/async/concurrency_classification.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "dependencies": [
        "async_threading"
      ],
      "risk": "high",
      "human_owner": "{module}/skills/async/concurrency_classification.md"
    },
    {
      "id": "async_sync_primitives_source",
      "description": "Synchronization primitives found in inspected source or diff load the concurrency evidence gate even when the task wording is neutral.",
      "priority": 22,
      "selectors": {
        "content_regex_any": [
          "\\block\\s*\\(",
          "\\b(?:Interlocked|Volatile|Monitor|Semaphore(?:Slim)?|Mutex|ReaderWriterLockSlim|SpinLock|EventWaitHandle|ManualResetEvent(?:Slim)?|AutoResetEvent|CountdownEvent|Concurrent[A-Z][A-Za-z0-9_]*)\\b"
        ]
      },
      "requirements": [
        {
          "id": "concurrency_classification_for_source",
          "mode": "all_of",
          "paths": [
            "{module}/skills/async/concurrency_classification.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "dependencies": [
        "async_threading"
      ],
      "risk": "high",
      "human_owner": "{module}/skills/async/concurrency_classification.md"
    },
    {
      "id": "sdk_privacy",
      "description": "SDK/privacy/consent work loads privacy compliance and its project override.",
      "priority": 22,
      "selectors": {
        "keywords_any": [
          "sdk",
          "consent",
          "att",
          "idfa",
          "idfv",
          "gdpr",
          "privacy",
          "tracking",
          "appsflyer",
          "analytics",
          "mediation",
          "attribution"
        ]
      },
      "requirements": [
        {
          "id": "skills_sdk",
          "mode": "all_of",
          "paths": [
            "{module}/skills/sdk/privacy_compliance.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "override_family": "sdk",
      "risk": "high",
      "human_owner": "{module}/skills/sdk/README.md"
    },
    {
      "id": "detached_callback_attribution",
      "description": "Triage of a framework-only exception stack loads the detached-callback attribution doctrine.",
      "priority": 22,
      "selectors": {
        "keywords_any": [
          "no application frame",
          "framework-only stack",
          "framework only stack",
          "playerlooprunner",
          "playerlooptimer",
          "first non-framework frame",
          "identical stacktrace",
          "stack-only",
          "detached callback",
          "timer callback",
          "scheduler callback"
        ]
      },
      "requirements": [
        {
          "id": "detached_callback_attribution",
          "mode": "all_of",
          "paths": [
            "{module}/knowledge/detached_callback_attribution.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "high",
      "human_owner": "{module}/knowledge/detached_callback_attribution.md"
    },
    {
      "id": "monetization_policy",
      "description": "Monetization-path changes load the monetization policy pack.",
      "priority": 23,
      "selectors": {
        "keywords_any": [
          "monetization",
          "ads",
          "ad revenue",
          "rewarded",
          "banner",
          "interstitial",
          "iap",
          "purchase",
          "subscription",
          "revenue"
        ]
      },
      "requirements": [
        {
          "id": "monetization_pack",
          "mode": "all_of",
          "paths": [
            "{module}/reviews/policy_packs/monetization_changes.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "dependencies": [
        "sdk_privacy"
      ],
      "risk": "critical",
      "human_owner": "{module}/reviews/policy_packs/monetization_changes.md"
    },
    {
      "id": "startup_policy",
      "description": "Startup/boot-path changes load startup guidance and its policy pack.",
      "priority": 24,
      "selectors": {
        "keywords_any": [
          "startup",
          "boot",
          "splash",
          "app launch",
          "initialization step",
          "loading step"
        ]
      },
      "requirements": [
        {
          "id": "startup_pack",
          "mode": "all_of",
          "paths": [
            "{module}/skills/mobile/startup.md",
            "{module}/reviews/policy_packs/startup_changes.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "high",
      "human_owner": "{module}/reviews/policy_packs/startup_changes.md"
    },
    {
      "id": "change_review_provenance",
      "description": "Branch, diff, commit, and PR reviews load the evidence-provenance owner so target-authored memory cannot validate its own change.",
      "priority": 29,
      "selectors": {
        "task_kinds": [
          "code_review"
        ],
        "keywords_any": [
          "branch",
          "diff",
          "commit",
          "pull request",
          "staged",
          "unstaged",
          "against release",
          "comparison base"
        ]
      },
      "requirements": [
        {
          "id": "review_evidence_provenance",
          "mode": "all_of",
          "paths": [
            "{module}/knowledge/review_evidence_provenance.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "normal",
      "human_owner": "{module}/knowledge/review_evidence_provenance.md"
    },
    {
      "id": "task_feature",
      "description": "Feature development playbook.",
      "priority": 30,
      "selectors": {
        "task_kinds": [
          "feature_development"
        ]
      },
      "requirements": [
        {
          "id": "task_feature",
          "mode": "all_of",
          "paths": [
            "{module}/tasks/feature_development.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "normal",
      "human_owner": "{module}/tasks/feature_development.md"
    },
    {
      "id": "task_bug",
      "description": "Bug-fixing playbook.",
      "priority": 31,
      "selectors": {
        "task_kinds": [
          "bug_fixing"
        ]
      },
      "requirements": [
        {
          "id": "task_bug",
          "mode": "all_of",
          "paths": [
            "{module}/tasks/bug_fixing.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "normal",
      "human_owner": "{module}/tasks/bug_fixing.md"
    },
    {
      "id": "task_refactoring",
      "description": "Refactoring playbook.",
      "priority": 32,
      "selectors": {
        "task_kinds": [
          "refactoring"
        ]
      },
      "requirements": [
        {
          "id": "task_refactoring",
          "mode": "all_of",
          "paths": [
            "{module}/tasks/refactoring.md"
          ],
          "weight": 1,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "normal",
      "human_owner": "{module}/tasks/refactoring.md"
    },
    {
      "id": "testing_doctrine",
      "description": "Code-changing task kinds require the testing doctrine.",
      "priority": 33,
      "selectors": {
        "task_kinds": [
          "feature_development",
          "bug_fixing",
          "refactoring"
        ]
      },
      "requirements": [
        {
          "id": "testing_doctrine",
          "mode": "all_of",
          "paths": [
            "{module}/skills/tests/testing_doctrine.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "normal",
      "human_owner": "{module}/skills/tests/testing_doctrine.md"
    },
    {
      "id": "high_risk_contracts",
      "description": "High/critical risk requires the execution, validation, and risk contracts.",
      "priority": 40,
      "selectors": {
        "risk_classes": [
          "high",
          "critical"
        ]
      },
      "requirements": [
        {
          "id": "risk_contracts",
          "mode": "all_of",
          "paths": [
            "{module}/knowledge/execution_contract.md",
            "{module}/knowledge/validation_contract.md",
            "{module}/knowledge/risk_classification.md"
          ],
          "weight": 2,
          "phase": "before_first_mutation"
        }
      ],
      "risk": "high",
      "human_owner": "{module}/knowledge/execution_contract.md"
    },
    {
      "id": "routing_gate",
      "description": "High/critical risk requires a non-shallow routing/execution contract, checked by the existing routing gate checker.",
      "priority": 50,
      "selectors": {
        "risk_classes": [
          "high",
          "critical"
        ]
      },
      "requirements": [
        {
          "id": "routing_contract",
          "mode": "semantic_checker",
          "checker_id": "routing_gate_check",
          "input_schema": "xuunity.execution-contract.v1",
          "required_fields": [
            "bug_family",
            "root_cause_chain_checked",
            "patch_shape"
          ],
          "empty_input_policy": "fail",
          "phase": "before_first_mutation",
          "severity": "blocking"
        }
      ],
      "dependencies": [
        "high_risk_contracts"
      ],
      "risk": "high",
      "human_owner": "{module}/knowledge/execution_contract.md"
    },
    {
      "id": "sdk_closeout_review",
      "description": "SDK-sensitive code signals (in inspected sources or in the actual diff) require the SDK change policy pack before closeout.",
      "priority": 60,
      "selectors": {
        "content_regex_any": [
          "AppsFlyer",
          "AppTrackingTransparency",
          "advertisingIdentifier",
          "vendorIdentifier",
          "RequestTrackingAuthorization",
          "\\bIDFA\\b",
          "\\bIDFV\\b"
        ]
      },
      "requirements": [
        {
          "id": "sdk_change_pack",
          "mode": "all_of",
          "paths": [
            "{module}/reviews/policy_packs/sdk_changes.md"
          ],
          "weight": 1,
          "phase": "before_closeout"
        }
      ],
      "risk": "high",
      "human_owner": "{module}/reviews/policy_packs/sdk_changes.md"
    }
  ],
  "ruleset_hash": "ce6bbb8719f9020b04d4a248ccba83d6f7fe9c37d7c0b30a4a28477c2e99742c"
}
